# ============================================================
# 能源可信数据空间平台 · 环境变量模板
# 使用：cp .env.example .env 后按需修改；变量名严格照 contract/API-CONTRACT.md 第四部分，
#       不得自创变量名。离线安装包的 install.sh 会自动生成随机密码覆盖下面的默认值。
# ============================================================

# --- 数据库（甲使用）---
MYSQL_ROOT_PASSWORD=root123          # MySQL root 密码（生产/安装包中由 install.sh 随机生成）
MYSQL_DATABASE=energy_tds            # 业务库名，建表脚本 backend/sql/01_schema.sql 在此库执行
MYSQL_USER=energy                    # 业务账号
MYSQL_PASSWORD=energy123             # 业务账号密码（安装包中随机生成）
MYSQL_HOST=mysql                     # compose 网络内主机名，勿改
MYSQL_PORT=3306

# --- Redis（甲使用）---
REDIS_HOST=redis                     # compose 网络内主机名，勿改
REDIS_PORT=6379

# --- 后端（甲）---
BACKEND_PORT=8000                    # backend 容器监听端口，nginx 反代到 backend:8000
JWT_SECRET=energy-tds-demo-secret-2026   # JWT 签名密钥（安装包中随机生成，切勿多实例共用）
JWT_EXPIRE_SECONDS=28800             # token 有效期 8 小时
ALGO_SERVICE_URL=http://algo-service:8100   # 后端调用算法服务的地址

# --- 算法服务（乙）---
ALGO_PORT=8100                       # algo-service 容器监听端口
DEEPSEEK_API_KEY=                    # 留空 = 跳过 live 调用，直接走 cache/rule 降级
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=8                   # 秒，超时即降级
DEEPSEEK_OFFLINE_FALLBACK=true       # 断网时使用本地缓存/规则模板，永远返回 200
# （algo 内部可选变量 FL_ROUND_DELAY=1.0 每轮间隔秒数，非契约变量，如需覆盖在 shell 环境中导出即可）

# --- 前端（乙）---
FRONTEND_PORT=80                     # 宿主机访问端口（被占用时改这里，例如 8080）
VITE_API_BASE=/api/v1                # 前端请求前缀，由 nginx 反代到 backend
VITE_WS_BASE=/ws                     # WebSocket 前缀
VITE_USE_MOCK=false                  # true = 前端走 MSW 假后端（答辩离线兜底 / 乙方独立联调）
