# 能源可信数据空间平台 · 开机自启（由 install.sh 安装到 /etc/systemd/system/）
[Unit]
Description=Energy Trusted Data Space Platform
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/energy-tds
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
