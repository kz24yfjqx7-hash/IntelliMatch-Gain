# 能源可信数据空间平台 · 树莓派 Chromium 全屏 Kiosk（仅 arm64 包安装）
# 等待平台健康检查通过后，以桌面用户身份全屏打开 http://localhost（逻辑在 /opt/energy-tds/kiosk.sh）
# install.sh 会把 __KIOSK_USER__ 替换为实际桌面用户（默认 pi），并把 kiosk.sh 装到 /opt/energy-tds/
[Unit]
Description=Energy TDS Kiosk (Chromium fullscreen)
After=energy-tds.service graphical.target
Wants=energy-tds.service

[Service]
Type=simple
User=__KIOSK_USER__
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/__KIOSK_USER__/.Xauthority
Environment=KIOSK_URL=http://localhost
Environment=KIOSK_WAIT_SECONDS=300
ExecStart=/bin/bash /opt/energy-tds/kiosk.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical.target
