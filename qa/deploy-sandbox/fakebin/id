#!/usr/bin/env bash
. "$(dirname "$0")/_log.sh"; flog "$@"
case "$*" in
  -u) echo "${FAKE_UID:-0}" ;;
  "") echo "uid=${FAKE_UID:-0}(root) gid=0(root)" ;;
  *) u="${*: -1}"; [[ " ${FAKE_USERS:-pi} " == *" $u "* ]] && { echo "uid=1000($u)"; exit 0; }; echo "id: '$u': no such user" >&2; exit 1 ;;
esac
